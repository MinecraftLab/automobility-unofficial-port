{
  "schemaVersion": 1,
  "id": "momentum",
  "version": "${version}",
  "name": "Momentum for Automobility: Unofficial Port",
  "description": "Unofficial Automobility addon port that improves vehicle movement feel and adds a compact driving HUD.",
  "authors": [
    "milkucha"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/momentum-for-automobility-unofficial-port",
    "sources": "https://git.offchunk.com/Offchunk/automobility-unofficial-port",
    "issues": "https://git.offchunk.com/Offchunk/automobility-unofficial-port/issues"
  },
  "license": "MIT",
  "icon": "momentum_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.milkucha.momentum.Momentum"
    ],
    "client": [
      "io.github.milkucha.momentum.MomentumClient"
    ],
    "controlify": [
      "io.github.milkucha.momentum.controlify.MomentumControlifyCompat"
    ],
    "modmenu": [
      "io.github.milkucha.momentum.modmenu.MomentumModMenuImpl"
    ]
  },
  "mixins": [
    "momentum.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": [
      "26.1",
      "26.1.1",
      "26.1.2"
    ],
    "java": ">=25",
    "automobility": ">=${automobility_version}"
  },
  "suggests": {
    "controlify": ">=3.0.2",
    "modmenu": "*",
    "yet_another_config_lib_v3": "*"
  }
}
