{
  "schemaVersion": 1,
  "id": "automobility",
  "version": "1.3.0+26.2-fabric",
  "name": "Automobility: Unofficial Port",
  "description": "Unofficial Automobility Fabric port for Minecraft 26.2, built and tested on 26.2.",
  "authors": [
    "FoundationGames",
    "David",
    "milkucha"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/automobility-unofficial-port",
    "sources": "https://git.offchunk.com/Offchunk/automobility-unofficial-port",
    "issues": "https://git.offchunk.com/Offchunk/automobility-unofficial-port/issues"
  },
  "license": [
    "MIT",
    "CC-BY-4.0"
  ],
  "icon": "automobility.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.foundationgames.automobility.fabric.AutomobilityFabric",
      "io.github.milkucha.momentum.Momentum"
    ],
    "client": [
      "io.github.foundationgames.automobility.fabric.AutomobilityClientFabric",
      "io.github.foundationgames.automobility.client.lighting.direct.bootstrap.DirectBootstrap",
      "io.github.milkucha.momentum.MomentumClient"
    ],
    "controlify": [
      "io.github.foundationgames.automobility.fabric.controller.controlify.ControlifyCompat",
      "io.github.milkucha.momentum.controlify.MomentumControlifyCompat"
    ],
    "modmenu": [
      "io.github.milkucha.momentum.modmenu.MomentumModMenuImpl"
    ]
  },
  "mixins": [
    "automobility.mixins.json",
    "automobility_fabric.mixins.json",
    {
      "config": "automobility_direct50.mixins.json",
      "environment": "client"
    },
    "momentum.mixins.json",
    {
      "config": "automobility_energy_hud.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "automobility.accesswidener",
  "breaks": {
    "momentum": "*"
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.153.0+26.2",
    "minecraft": "26.2",
    "java": ">=25"
  },
  "suggests": {
    "controlify": ">=3.0.2",
    "modmenu": "*",
    "yet_another_config_lib_v3": "*"
  },
  "jars": [
    {
      "file": "META-INF/jars/obj-0.4.0.jar"
    }
  ]
}
